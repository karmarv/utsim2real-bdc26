# Source this file in every shell that works on the project:  source common/env/bdc26.env
# Paths are overridable: export BDC_DATA=... before sourcing.
export BDC_REPO="${BDC_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export BDC_DATA="${BDC_DATA:-$(dirname "$BDC_REPO")/bdc26-data}"      # large data, outside git
export BDC_THIRD_PARTY="${BDC_THIRD_PARTY:-$BDC_DATA/third_party}"      # OpenPCDet clone etc.
export PCDET_ROOT="${PCDET_ROOT:-$BDC_THIRD_PARTY/OpenPCDet}"
export PYTHONPATH="$BDC_REPO/common${PYTHONPATH:+:$PYTHONPATH}"
# CUDA for building OpenPCDet ops against the cu121 torch wheel (minor mismatch with nvcc 12.8 is harmless)
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-12.8}"
export TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-8.6}"
# Team name written into every submission declaration (common/tools/package_submission.py, check_submission.py)
export BDC_TEAM="${BDC_TEAM:-KarmaRV}"
